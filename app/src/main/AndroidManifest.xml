<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FindIt">

        <activity
            android:name=".admin.activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <activity
            android:name=".admin.activities.AdminReportsActivity"
            android:exported="false" />
        <activity
            android:name=".admin.activities.ManageUsersActivity"
            android:exported="false" />
        <activity
            android:name=".admin.activities.ManageClaimsAdminActivity"
            android:exported="false" />
        <activity
            android:name=".admin.activities.VerifyReportsActivity"
            android:exported="false" />
        <activity
            android:name=".admin.activities.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".admin.activities.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false">
        </activity>
        <activity android:name=".SearchActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".admin.activities.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".admin.activities.ReportItemActivity"
            android:exported="false" />

        <activity
            android:name=".admin.activities.MyItemsActivity"
            android:exported="false" />
        <activity android:name=".FoundItemsActivity" android:exported="false" />
        <activity android:name=".LostItemsActivity" android:exported="false" />
        <activity android:name=".ItemDetailsActivity" android:exported="false" />
    </application>

</manifest>